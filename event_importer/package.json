{
  "name": "aewmai-event-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dry-run": "tsx src/index.ts",
    "dry-run:daily": "tsx src/index.ts --group daily",
    "dry-run:frequent": "tsx src/index.ts --group frequent",
    "import": "tsx src/index.ts --write",
    "import:daily": "tsx src/index.ts --write --group daily --trigger scheduled",
    "import:frequent": "tsx src/index.ts --write --group frequent --trigger scheduled",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@tesseract.js-data/tha": "^1.0.0",
    "cheerio": "^1.1.2",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
